[chief]
agent = "codex"
# model = "gpt-5"
# model_reasoning_effort = "high"
agent_extra_args = []
max_retries = 10
agent_timeout_seconds = 2700
agent_log_max_output_lines = 10
agent_log_max_output_chars = 1500
use_agent_log_truncation_for_stdout_logs = false

[backend]
host = "0.0.0.0"
port = 8000
# projects_parent_dir can be set for backend default project discovery.
# projects_parent_dir = "/workspace/projects"
frontend_dir = "frontend"
default_agents_per_project = 1
max_agents_per_project = 8

# -----------------------------
# Rust project suite
# -----------------------------
[[suites]]
name = "backend"
language = "Rust"
framework = "cargo test"
test_root = "."
test_command = "cargo test"
target_type = "project"
default_target = "."
file_patterns = []
lint_command = "cargo clippy"
# lint_fix_command = "cargo fmt"
post_green_command = "cargo test"
env = {}
strip_root_from_target = true

